        function setLanguage(lang) {
            const data = TRANSLATIONS[lang] || TRANSLATIONS.es;

            document.getElementById('uiLangHint').innerText = data.langHint;
            document.getElementById('uiBio').innerText = data.bio;

            document.getElementById('t_btn1_title').innerText = data.btn1_title;
            document.getElementById('t_btn1_badge').innerText = data.btn1_badge;
            document.getElementById('t_btn1_desc').innerText = data.btn1_desc;

            document.getElementById('t_btn2_title').innerText = data.btn2_title;
            document.getElementById('t_btn2_desc').innerText = data.btn2_desc;

            document.getElementById('t_btn3_title').innerText = data.btn3_title;
            document.getElementById('t_btn3_badge').innerText = data.btn3_badge;
            document.getElementById('t_btn3_desc').innerText = data.btn3_desc;

            document.getElementById('t_btn4_title').innerText = data.btn4_title;
            document.getElementById('t_btn4_badge').innerText = data.btn4_badge;
            document.getElementById('t_btn4_desc').innerText = data.btn4_desc;

            document.getElementById('t_btn5_title').innerText = data.btn5_title;
            document.getElementById('t_btn5_badge').innerText = data.btn5_badge;
            document.getElementById('t_btn5_desc').innerText = data.btn5_desc;

            document.getElementById('t_btn6_title').innerText = data.btn6_title;
            document.getElementById('t_footer_badge').innerText = data.footer_badge;

            document.getElementById('t_modal_title').innerText = data.modal_title;
            document.getElementById('t_modal_desc').innerText = data.modal_desc;
            document.getElementById('t_modal_btn').innerText = data.modal_btn;

            document.getElementById('t_soft_title').innerText = data.soft_title;
            document.getElementById('t_soft_desc').innerText = data.soft_desc;
            document.getElementById('t_soft_cta').innerText = data.soft_cta;

            // =========================================================================
            // ACTUALIZACIÓN DINÁMICA DE ENLACES DE WHATSAPP AL IDIOMA SELECCIONADO
            // =========================================================================
            const wspBase = "https://wa.me/5491131933611?text=";
            document.getElementById('btnWspMain').href = wspBase + encodeURIComponent(data.wsp_main_msg);
            document.getElementById('socialWspTop').href = wspBase + encodeURIComponent(data.wsp_main_msg);
            document.getElementById('t_soft_cta').href = wspBase + encodeURIComponent(data.wsp_soft_msg);

            // Resaltar botón de idioma activo
            document.querySelectorAll('.lang-btn').forEach(btn => btn.classList.remove('active'));
            if (lang === 'es') document.getElementById('btnLangEs').classList.add('active');
            if (lang === 'pt') document.getElementById('btnLangPt').classList.add('active');
            if (lang === 'en') document.getElementById('btnLangEn').classList.add('active');

            try {
                localStorage.setItem('1111_preferred_lang', lang);
            } catch(e) {}
        }

        // INICIALIZACIÓN
        window.addEventListener('DOMContentLoaded', () => {
            if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
            requestAnimationFrame(() => document.body.classList.remove('preload'));

            let savedLang = 'es';
            try {
                savedLang = localStorage.getItem('1111_preferred_lang') || 'es';
            } catch(e) {}
            setLanguage(savedLang);

            startBackgroundPreload();
        });
    </script>
