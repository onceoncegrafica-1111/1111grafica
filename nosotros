    <!-- SCRIPT DE FOTOS REALES, NAVEGACIÓN Y TRADUCCIÓN COMPLETA -->
    <script>
        const TOTAL_PHOTOS = 50;

        // Estructura optimizada con tus carpetas miniaturas (8KB) e imagenes (HD)
        const GITHUB_PHOTOS = Array.from({ length: TOTAL_PHOTOS }, (_, i) => ({
            id: i + 1,
            thumb: `https://cdn.jsdelivr.net/gh/onceoncegrafica-1111/1111grafica@main/miniaturas/foto_${i + 1}.webp`,
            full: `https://cdn.jsdelivr.net/gh/onceoncegrafica-1111/1111grafica@main/imagenes/foto_${i + 1}.webp`,
            fallbackThumb: `./miniaturas/foto_${i + 1}.webp`,
            fallbackFull: `./imagenes/foto_${i + 1}.webp`
        }));

        let activeShuffledPhotos = [];
        let currentPhotoIndex = 0;

        // PRECARGA INVISIBLE EN SEGUNDO PLANO
        function startBackgroundPreload() {
            setTimeout(() => {
                GITHUB_PHOTOS.slice(0, 18).forEach(item => {
                    const preloadImg = new Image();
                    preloadImg.src = item.thumb;
                });
            }, 1200);
        }

        // ALGORITMO FISHER-YATES: ORDEN ALEATORIO
        function shuffleArray(arr) {
            const copy = [...arr];
            for (let i = copy.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [copy[i], copy[j]] = [copy[j], copy[i]];
            }
            return copy;
        }

        // RENDERIZADO DE LA GRILLA
        function renderShuffledGallery() {
            const container = document.getElementById('dynamicGalleryGrid');
            container.innerHTML = '';

            activeShuffledPhotos = shuffleArray(GITHUB_PHOTOS);

            activeShuffledPhotos.forEach((item, index) => {
                const wrap = document.createElement('div');
                wrap.className = 'gallery-item-wrap';
                wrap.onclick = () => openLightbox(index);

                const img = document.createElement('img');
                img.alt = `Trabajo 1111 Gráfica #${item.id}`;
                img.loading = 'lazy';
                img.decoding = 'async';

                img.onload = function() {
                    wrap.classList.add('loaded');
                };

                // Si por alguna razón la miniatura tarda, recurre a la imagen principal
                img.onerror = function() {
                    if (!this.dataset.triedOriginal) {
                        this.dataset.triedOriginal = "true";
                        this.src = item.full;
                    } else if (!this.dataset.triedFallback) {
                        this.dataset.triedFallback = "true";
                        this.src = item.fallbackFull;
                    } else {
                        wrap.style.display = 'none';
                    }
                };

                img.src = item.thumb;

                wrap.appendChild(img);
                container.appendChild(wrap);
            });
        }

        // CONTROL DEL LIGHTBOX
        function openLightbox(index) {
            currentPhotoIndex = index;
            updateLightboxContent();
            document.getElementById('lightboxView').classList.add('active');

            try {
                history.pushState({ lbOpen: true }, '');
            } catch(e) {}
        }

        function updateLightboxContent() {
            const item = activeShuffledPhotos[currentPhotoIndex];
            const img = document.getElementById('lightboxImg');
            const counter = document.getElementById('lightboxCounter');

            img.src = item.full;
            counter.innerText = `${currentPhotoIndex + 1} / ${activeShuffledPhotos.length}`;

            // Precarga la foto siguiente en silencio para fluidez
            const nextIdx = (currentPhotoIndex + 1) % activeShuffledPhotos.length;
            const nextCache = new Image();
            nextCache.src = activeShuffledPhotos[nextIdx].full;
        }

        function navLightbox(direction, event) {
            if (event) event.stopPropagation();
            currentPhotoIndex += direction;
            if (currentPhotoIndex < 0) currentPhotoIndex = activeShuffledPhotos.length - 1;
            if (currentPhotoIndex >= activeShuffledPhotos.length) currentPhotoIndex = 0;
            updateLightboxContent();
        }

        function closeLightbox() {
            document.getElementById('lightboxView').classList.remove('active');
        }

        function closeLightboxOnBg(event) {
            if (event.target.id === 'lightboxView') closeLightbox();
        }

        window.addEventListener('keydown', (e) => {
            const lb = document.getElementById('lightboxView');
            if (lb.classList.contains('active')) {
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowLeft') navLightbox(-1);
                if (e.key === 'ArrowRight') navLightbox(1);
            }
        });

        window.addEventListener('popstate', () => closeLightbox());

        // DESLIZAR CON EL DEDO (SWIPE)
        let touchStartX = 0;
        let touchEndX = 0;
        const lbView = document.getElementById('lightboxView');

        lbView.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        lbView.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            if (touchEndX < touchStartX - 45) navLightbox(1);
            if (touchEndX > touchStartX + 45) navLightbox(-1);
        }, { passive: true });

        // MODALES
        function openGalleryModal() {
            renderShuffledGallery();
            document.getElementById('galleryModal').classList.add('active');
        }

        function openSoftwareModal() {
            document.getElementById('softwareModal').classList.add('active');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        function closeOnBackdrop(e, id) {
            if (e.target.id === id) closeModal(id);
        }

        // =========================================================================
        // TRADUCCIONES TRILINGÜES CON MENSAJES DE WHATSAPP DINÁMICOS
        // =========================================================================
        const TRANSLATIONS = {
            es: {
                langHint: "🌐 Idioma",
                bio: "Identidad visual, impresiones premium y herramientas digitales para potenciar tu negocio.",
                btn1_title: "Atención por WhatsApp",
                btn1_badge: "Respuesta Rápida",
                btn1_desc: "Cotizaciones, pedidos y asesoramiento directo",
